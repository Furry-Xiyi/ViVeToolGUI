<Page
    x:Class="ViVeToolGUI.Pages.QueryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ViVeToolGUI.Pages">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Padding="20,20,20,20"
                    Orientation="Horizontal"
                    Spacing="12">
            <Button x:Name="QueryAllButton"
                    x:Uid="Query_QueryAllButton"
                    Style="{StaticResource AccentButtonStyle}"
                    MinWidth="100"
                    Click="QueryAllButton_Click"/>

            <Button x:Name="ExportButton"
                    x:Uid="Query_ExportButton"
                    Click="ExportButton_Click"
                    MinWidth="100"
                    IsEnabled="False"/>

            <Button x:Name="ViewButton"
                    x:Uid="Query_ViewButton"
                    Click="ViewButton_Click"
                    MinWidth="100"/>

            <TextBox x:Name="SearchBox"
                     x:Uid="Query_SearchBox"
                     Width="300"
                     TextChanged="SearchBox_TextChanged"/>
        </StackPanel>

        <Grid Grid.Row="1"
              Padding="20,0,20,20">
            <Border BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Padding="25,8,12,8"
                          ColumnSpacing="12"
                          Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Uid="Query_HeaderID"
                                   Grid.Column="0"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Uid="Query_HeaderState"
                                   Grid.Column="1"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Uid="Query_HeaderVariant"
                                   Grid.Column="2"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Uid="Query_HeaderVariantPayload"
                                   Grid.Column="3"
                                   FontWeight="SemiBold"/>
                    </Grid>

                    <ListView x:Name="FeaturesListView"
                              Grid.Row="1"
                              SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:FeatureInfo">
                                <Grid Padding="12,6"
                                      ColumnSpacing="12"
                                      Background="Transparent">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout Opening="MenuFlyout_Opening">
                                            <MenuFlyoutItem x:Name="MenuEnable" 
                    x:Uid="Menu_EnableFeature"
                    Click="EnableFeature_Click"
                    CommandParameter="{x:Bind}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE73E;"/>
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Name="MenuDisable" 
                    x:Uid="Menu_DisableFeature"
                    Click="DisableFeature_Click"
                    CommandParameter="{x:Bind}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE711;"/>
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>

                                            <MenuFlyoutItem x:Uid="Menu_RestoreFeature"
                    Click="RestoreFeature_Click"
                    CommandParameter="{x:Bind}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE777;"/>
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>

                                            <MenuFlyoutSeparator/>

                                            <MenuFlyoutItem x:Uid="Menu_CopyFeatureId"
                                                            Click="CopyFeatureId_Click"
                                                            CommandParameter="{x:Bind}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8C8;"/>
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{x:Bind Id}"
                                               FontFamily="Consolas"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind State}"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{x:Bind Variant}"/>
                                    <TextBlock Grid.Column="3"
                                               Text="{x:Bind VariantPayload}"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>