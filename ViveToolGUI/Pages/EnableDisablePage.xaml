<Page
    x:Class="ViVeToolGUI.Pages.EnableDisablePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Padding="20,20,20,20"
                    Spacing="0">

            <controls:SettingsCard x:Uid="EnableDisable_FeatureIDCard"
                       HorizontalAlignment="Stretch"
                       HorizontalContentAlignment="Stretch"
                       MinHeight="70"
                       Padding="16,0"
                       Margin="0,0,0,5">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xF1AD;"
                              FontSize="28"/>
                </controls:SettingsCard.HeaderIcon>

                <Grid MinWidth="0"
                      VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="ValidationText"
                               x:Uid="EnableDisable_InvalidID"
                               Grid.Column="0"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               Visibility="Collapsed"/>

                    <TextBox x:Name="FeatureIDTextBox"
                             x:Uid="EnableDisable_FeatureIDBox"
                             Grid.Column="1"
                             TextChanged="FeatureIDTextBox_TextChanged"
                             KeyDown="FeatureIDTextBox_KeyDown"
                             Height="64"
                             MinWidth="128"
                             HorizontalAlignment="Stretch"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"/>
                </Grid>
            </controls:SettingsCard>

            <Rectangle Height="1"
                       Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                       Margin="0,0,0,5"/>

            <Expander Grid.Row="2"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      MinHeight="70">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal"
                                Spacing="12">
                        <FontIcon Glyph="&#xEC7A;"
                                  Width="25"
                                  FontSize="20"/>
                        <StackPanel Margin="5,0,0,0">
                            <TextBlock x:Uid="EnableDisable_Variant"
                                       FontSize="14.4"/>
                            <TextBlock x:Uid="EnableDisable_VariantDescription"
                                       FontSize="12"
                                       Opacity="0.8"/>
                        </StackPanel>
                    </StackPanel>
                </Expander.Header>

                <Grid Padding="30,8,0,16"
                      ColumnSpacing="16"
                      RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               x:Uid="EnableDisable_Variant"
                               VerticalAlignment="Center"
                               Opacity="0.8"/>

                    <ComboBox x:Name="VariantModeComboBox"
                              Grid.Row="0"
                              Grid.Column="1"
                              Width="260"
                              HorizontalAlignment="Left"
                              SelectionChanged="VariantModeComboBox_SelectionChanged">
                        <ComboBoxItem x:Uid="VariantMode_None"
                                      IsSelected="True"
                                      Tag="None"/>
                        <ComboBoxItem x:Uid="VariantMode_Custom"
                                      Tag="Custom"/>
                        <ComboBoxItem x:Uid="VariantMode_Clear"
                                      Tag="Clear"/>
                    </ComboBox>

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               x:Uid="EnableDisable_VariantNumber"
                               VerticalAlignment="Center"
                               Opacity="0.8"/>

                    <NumberBox x:Name="VariantNumberBox"
                               Grid.Row="1"
                               Grid.Column="1"
                               Minimum="0"
                               Maximum="4294967295"
                               IsEnabled="False"
                               SpinButtonPlacementMode="Inline"
                               Width="260"
                               HorizontalAlignment="Left"/>
                </Grid>
            </Expander>
        </StackPanel>

        <Grid Grid.Row="1">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                Margin="0,-8,0,0"/>

            <StackPanel Padding="20,10,20,20"
                    Spacing="20">
                <StackPanel Orientation="Horizontal"
                        Spacing="12">
                    <Button x:Name="EnableButton"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="EnableButton_Click"
                        IsEnabled="False">
                        <StackPanel Orientation="Horizontal"
                                Spacing="8">
                            <FontIcon Glyph="&#xE73E;"
                                  FontSize="16"/>
                            <TextBlock x:Uid="EnableDisable_EnableButton"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="DisableButton"
                        Click="DisableButton_Click"
                        IsEnabled="False">
                        <StackPanel Orientation="Horizontal"
                                Spacing="8">
                            <FontIcon Glyph="&#xE711;"
                                  FontSize="16"/>
                            <TextBlock x:Uid="EnableDisable_DisableButton"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="RestoreButton"
                        Click="RestoreButton_Click"
                        IsEnabled="False">
                        <StackPanel Orientation="Horizontal"
                                Spacing="8">
                            <FontIcon Glyph="&#xE777;"
                                  FontSize="16"/>
                            <TextBlock x:Uid="EnableDisable_RestoreButton"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Page>