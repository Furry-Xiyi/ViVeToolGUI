<Page
    x:Class="ViVeToolGUI.Pages.EnableDisablePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:ViVeToolGUI.Pages">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Padding="20,20,20,0" Spacing="0">
            <controls:SettingsCard x:Uid="EnableDisable_FeatureIDCard"
                   HorizontalAlignment="Stretch"
                   HorizontalContentAlignment="Stretch"
                   MinHeight="70"
                   Padding="16,0"
                   Margin="0,0,0,5">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xF1AD;" FontSize="28"/>
                </controls:SettingsCard.HeaderIcon>

                <Grid MinWidth="0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="ValidationText"
                               x:Uid="EnableDisable_InvalidID"
                               Grid.Column="0"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               Visibility="Collapsed"/>

                    <TextBox x:Name="FeatureIDTextBox"
                             x:Uid="EnableDisable_FeatureIDBox"
                             Grid.Column="1"
                             TextChanged="FeatureIDTextBox_TextChanged"
                             KeyDown="FeatureIDTextBox_KeyDown"
                             Height="64"
                             MinWidth="128"
                             HorizontalAlignment="Stretch"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"/>
                </Grid>
            </controls:SettingsCard>

            <Rectangle Height="1"
                       Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                       Margin="0,0,0,5"/>

            <Expander HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      MinHeight="70">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xEC7A;" Width="25" FontSize="20"/>
                        <StackPanel Margin="5,0,0,0">
                            <TextBlock x:Uid="EnableDisable_Variant" FontSize="14.4"/>
                            <TextBlock x:Uid="EnableDisable_VariantDescription"
                                       FontSize="12" Opacity="0.8"/>
                        </StackPanel>
                    </StackPanel>
                </Expander.Header>

                <Grid Padding="30,8,0,16" ColumnSpacing="16" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               x:Uid="EnableDisable_Variant"
                               VerticalAlignment="Center" Opacity="0.8"/>

                    <ComboBox x:Name="VariantModeComboBox"
                              Grid.Row="0" Grid.Column="1"
                              Width="260" HorizontalAlignment="Left"
                              SelectionChanged="VariantModeComboBox_SelectionChanged">
                        <ComboBoxItem x:Uid="VariantMode_None" IsSelected="True" Tag="None"/>
                        <ComboBoxItem x:Uid="VariantMode_Custom" Tag="Custom"/>
                        <ComboBoxItem x:Uid="VariantMode_Clear" Tag="Clear"/>
                    </ComboBox>

                    <TextBlock Grid.Row="1" Grid.Column="0"
                               x:Uid="EnableDisable_VariantNumber"
                               VerticalAlignment="Center" Opacity="0.8"/>

                    <NumberBox x:Name="VariantNumberBox"
                               Grid.Row="1" Grid.Column="1"
                               Minimum="0" Maximum="4294967295"
                               IsEnabled="False"
                               SpinButtonPlacementMode="Inline"
                               Width="260" HorizontalAlignment="Left"/>
                </Grid>
            </Expander>
        </StackPanel>

        <Grid Grid.Row="1" Padding="20,10,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,6">
                <TextBlock x:Uid="History"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <Button x:Name="ClearHistoryButton"
                        x:Uid="ClearHistoryButton"
                        HorizontalAlignment="Right"
                        Click="ClearHistoryButton_Click"
                        Padding="6,4">
                    <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                </Button>
            </Grid>

            <Border Grid.Row="1"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Padding="25,8,12,8"
                          ColumnSpacing="12"
                          Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Uid="History_HeaderTime" Grid.Column="0" FontWeight="SemiBold"/>
                        <TextBlock x:Uid="Query_HeaderID" Grid.Column="1" FontWeight="SemiBold"/>
                        <TextBlock x:Uid="Query_HeaderState" Grid.Column="2" FontWeight="SemiBold"/>
                    </Grid>

                    <ListView x:Name="HistoryListView"
                              Grid.Row="1"
                              SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:OperationRecord">
                                <Grid Padding="12,6" ColumnSpacing="12">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout Opening="HistoryMenuFlyout_Opening">
                                            <MenuFlyoutItem x:Name="MenuHistoryEnable"
                    x:Uid="Menu_EnableFeature"
                    Click="HistoryEnable_Click"
                    CommandParameter="{x:Bind}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE73E;"/>
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Name="MenuHistoryDisable"
                    x:Uid="Menu_DisableFeature"
                    Click="HistoryDisable_Click"
                    CommandParameter="{x:Bind}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE711;"/>
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Uid="Menu_RestoreFeature"
                    Click="HistoryRestore_Click"
                    CommandParameter="{x:Bind}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE777;"/>
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator/>
                                            <MenuFlyoutItem x:Uid="Menu_CopyFeatureId"
                    Click="HistoryCopyId_Click"
                    CommandParameter="{x:Bind}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8C8;"/>
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem x:Uid="Menu_HistoryDelete"
                    Click="HistoryDelete_Click"
                    CommandParameter="{x:Bind}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE74D;"
                      Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                                                </MenuFlyoutItem.Icon>
                                                <MenuFlyoutItem.Foreground>
                                                    <StaticResource ResourceKey="SystemFillColorCriticalBrush"/>
                                                </MenuFlyoutItem.Foreground>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{x:Bind Time}"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind FeatureId}"
                                               FontFamily="Consolas"/>
                                    <TextBlock Grid.Column="2" Text="{x:Bind Operation}"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    Margin="0,-8,0,0"/>

            <StackPanel Padding="20,10,20,20" Spacing="20">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Name="EnableButton"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="EnableButton_Click"
                            IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE73E;" FontSize="16"/>
                            <TextBlock x:Uid="EnableDisable_EnableButton"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="DisableButton"
                            Click="DisableButton_Click"
                            IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE711;" FontSize="16"/>
                            <TextBlock x:Uid="EnableDisable_DisableButton"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="RestoreButton"
                            Click="RestoreButton_Click"
                            IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE777;" FontSize="16"/>
                            <TextBlock x:Uid="EnableDisable_RestoreButton"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Page>