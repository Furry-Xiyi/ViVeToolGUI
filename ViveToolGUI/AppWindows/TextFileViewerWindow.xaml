<Window
    x:Class="ViVeToolGUI.AppWindows.TextFileViewerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:CommunityToolkit.WinUI.Behaviors"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:local="using:ViVeToolGUI.AppWindows"
    xmlns:ct="using:CommunityToolkit.WinUI.Controls"
    Title="Features Viewer">

    <Grid x:Name="RootGrid" Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.Resources>
            <ResourceDictionary>
                <MenuFlyout x:Name="RowContextMenu" Placement="RightEdgeAlignedTop">
                    <MenuFlyoutItem x:Name="CmdEnable" x:Uid="Menu_EnableFeature" Click="CmdEnable_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE73E;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Name="CmdDisable" x:Uid="Menu_DisableFeature" Click="CmdDisable_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE711;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Name="CmdRestore" x:Uid="Menu_RestoreFeature" Click="CmdRestore_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE777;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem x:Name="CmdCopy" x:Uid="Menu_CopyText" Click="CmdCopy_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8C8;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Name="CmdSelectAll" x:Uid="Menu_SelectAll" Click="CmdSelectAll_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8B3;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
                <Storyboard x:Name="ShowControlsStoryboard">
                    <DoubleAnimation Storyboard.TargetName="MatchCaseToggle" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                    <DoubleAnimation Storyboard.TargetName="NavButtonsPanel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                    <DoubleAnimation Storyboard.TargetName="MatchCaseToggleTransform" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.2"/>
                    <DoubleAnimation Storyboard.TargetName="NavButtonsTransform" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.2"/>
                </Storyboard>
                <Storyboard x:Name="HideControlsStoryboard">
                    <DoubleAnimation Storyboard.TargetName="MatchCaseToggle" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                    <DoubleAnimation Storyboard.TargetName="NavButtonsPanel" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                    <DoubleAnimation Storyboard.TargetName="MatchCaseToggleTransform" Storyboard.TargetProperty="X" To="36" Duration="0:0:0.15"/>
                    <DoubleAnimation Storyboard.TargetName="NavButtonsTransform" Storyboard.TargetProperty="X" To="-36" Duration="0:0:0.15"/>
                </Storyboard>
                <Storyboard x:Name="InfoBarSlideIn">
                    <DoubleAnimation Storyboard.TargetName="InfoBarTransform" Storyboard.TargetProperty="Y" From="-60" To="0" Duration="0:0:0.3">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="StatusInfoBar" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
                </Storyboard>
                <Storyboard x:Name="InfoBarSlideOut">
                    <DoubleAnimation Storyboard.TargetName="InfoBarTransform" Storyboard.TargetProperty="Y" From="0" To="-60" Duration="0:0:0.25">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseIn"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="StatusInfoBar" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.25"/>
                </Storyboard>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent" VerticalAlignment="Stretch">
            <Grid x:Name="ControlContainer" HorizontalAlignment="Center" VerticalAlignment="Center" Height="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ToggleButton x:Name="MatchCaseToggle" x:Uid="TextFileViewerWindowMatchCaseToggle" Grid.Column="0" Padding="0" Width="32" Height="32" Background="Transparent" Style="{StaticResource ToggleButtonRevealStyle}" Margin="0,0,8,0" Opacity="0" IsHitTestVisible="False" Click="MatchCaseToggle_Click">
                    <ToggleButton.RenderTransform>
                        <TranslateTransform x:Name="MatchCaseToggleTransform" X="36"/>
                    </ToggleButton.RenderTransform>
                    <FontIcon FontSize="14" Glyph="&#xE8E9;"/>
                </ToggleButton>

                <TextBox x:Name="SearchBox" x:Uid="TextFileViewerWindowSearchBox" Grid.Column="1" Width="500" CornerRadius="16" GotFocus="SearchBox_GotFocus" LostFocus="SearchBox_LostFocus" TextChanged="SearchBox_TextChanged"/>

                <StackPanel x:Name="NavButtonsPanel" Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0" Opacity="0" IsHitTestVisible="False">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="NavButtonsTransform" X="-36"/>
                    </StackPanel.RenderTransform>
                    <Button x:Name="PrevButton" x:Uid="TextFileViewerWindowPrevButton" Padding="0" Width="32" Height="32" Background="Transparent" Style="{StaticResource ButtonRevealStyle}" Click="PrevButton_Click">
                        <FontIcon FontSize="14" Glyph="&#xE74A;"/>
                    </Button>
                    <Button x:Name="NextButton" x:Uid="TextFileViewerWindowNextButton" Padding="0" Width="32" Height="32" Background="Transparent" Style="{StaticResource ButtonRevealStyle}" Click="NextButton_Click">
                        <FontIcon FontSize="14" Glyph="&#xE74B;"/>
                    </Button>
                    <TextBlock x:Name="MatchCountText" VerticalAlignment="Center" Margin="6,0,0,0" MinWidth="36"
               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <Button x:Name="RefreshButton" x:Uid="RefreshButton" Grid.Column="3" Padding="0" Width="32" Height="32" Background="Transparent" Style="{StaticResource ButtonRevealStyle}" Margin="4,0,0,0" Visibility="Collapsed" VerticalAlignment="Center" Click="RefreshButton_Click">
                    <FontIcon x:Name="RefreshIcon" FontSize="14" Glyph="&#xE72C;">
                        <FontIcon.RenderTransform>
                            <RotateTransform x:Name="RefreshIconRotation" CenterX="7" CenterY="7"/>
                        </FontIcon.RenderTransform>
                    </FontIcon>
                </Button>
            </Grid>
        </Grid>

        <InfoBar x:Name="StatusInfoBar" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Center" IsOpen="False" IsClosable="False" Canvas.ZIndex="99" Opacity="0" Margin="0,2,0,0" Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}">
            <InfoBar.RenderTransform>
                <TranslateTransform x:Name="InfoBarTransform" Y="-60"/>
            </InfoBar.RenderTransform>
        </InfoBar>

        <ListView x:Name="FeaturesListView" Grid.Row="1"
          ItemsSource="{x:Bind FilteredItems}"
          SelectionMode="Single">
            <ListView.Header>
                <Border x:Name="HeaderBorder" Padding="12,8,12,8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <interactivity:Interaction.Behaviors>
                        <behaviors:StickyHeaderBehavior/>
                    </interactivity:Interaction.Behaviors>
                    <ct:DataTable x:Name="HeaderDataTable" ColumnSpacing="12" Background="Transparent" SizeChanged="HeaderTable_SizeChanged">
                        <ct:DataColumn x:Name="ColIdColumn" CanResize="True" DesiredWidth="200" SizeChanged="HeaderTable_SizeChanged">
                            <TextBlock x:Uid="ColIdHeader" FontWeight="SemiBold" FontSize="14" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                        </ct:DataColumn>
                        <ct:DataColumn x:Name="ColVariantColumn" CanResize="True" DesiredWidth="120" SizeChanged="HeaderTable_SizeChanged">
                            <TextBlock x:Uid="ColVariantHeader" FontWeight="SemiBold" FontSize="14" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                        </ct:DataColumn>
                        <ct:DataColumn x:Name="ColDescriptionColumn" DesiredWidth="*">
                            <TextBlock x:Uid="ColDescriptionHeader" FontWeight="SemiBold" FontSize="14" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                        </ct:DataColumn>
                        <ct:DataColumn CanResize="False" DesiredWidth="2">
                            <Border/>
                        </ct:DataColumn>
                    </ct:DataTable>
                </Border>
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:FeatureEntry">
                    <Grid Background="Transparent" Padding="12,4,12,4" Tag="{x:Bind}">
                        <Grid.ContextFlyout>
                            <MenuFlyout Opening="FeatureRowMenuFlyout_Opening">
                                <MenuFlyoutItem x:Uid="Menu_EnableFeature" Click="CmdEnable_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE73E;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Uid="Menu_DisableFeature" Click="CmdDisable_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE711;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Uid="Menu_RestoreFeature" Click="CmdRestore_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE777;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem x:Uid="Menu_CopyText" Click="CmdCopy_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8C8;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Uid="Menu_SelectAll" Click="CmdSelectAll_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8B3;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Grid.ContextFlyout>
                        <ct:DataRow>
                            <TextBlock VerticalAlignment="Center" IsTextSelectionEnabled="True" TextWrapping="NoWrap"
                               SelectionFlyout="{x:Null}"
                               local:SearchHighlight.SourceText="{x:Bind Id}"
                               local:SearchHighlight.Query="{x:Bind Query, Mode=OneWay}"
                               local:SearchHighlight.CaseSensitive="{x:Bind CaseSensitive, Mode=OneWay}"
                               local:SearchHighlight.IsCurrentField="{x:Bind IdIsCurrent, Mode=OneWay}"
                               local:SearchHighlight.CurrentMatchPos="{x:Bind CurrentMatchPos, Mode=OneWay}">
                                <TextBlock.ContextFlyout>
                            <MenuFlyout Opening="FeatureRowMenuFlyout_Opening">
                                <MenuFlyoutItem x:Uid="Menu_EnableFeature" Click="CmdEnable_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE73E;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Uid="Menu_DisableFeature" Click="CmdDisable_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE711;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Uid="Menu_RestoreFeature" Click="CmdRestore_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE777;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem x:Uid="Menu_CopyText" Click="CmdCopy_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8C8;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Uid="Menu_SelectAll" Click="CmdSelectAll_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8B3;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>                                </TextBlock.ContextFlyout>
                            </TextBlock>
                            <TextBlock VerticalAlignment="Center" IsTextSelectionEnabled="True" TextWrapping="NoWrap"
                               SelectionFlyout="{x:Null}"
                               local:SearchHighlight.SourceText="{x:Bind Variant}"
                               local:SearchHighlight.Query="{x:Bind Query, Mode=OneWay}"
                               local:SearchHighlight.CaseSensitive="{x:Bind CaseSensitive, Mode=OneWay}"
                               local:SearchHighlight.IsCurrentField="{x:Bind VariantIsCurrent, Mode=OneWay}"
                               local:SearchHighlight.CurrentMatchPos="{x:Bind CurrentMatchPos, Mode=OneWay}">
                                <TextBlock.ContextFlyout>
                                    <MenuFlyout Opening="FeatureRowMenuFlyout_Opening">
                                        <MenuFlyoutItem x:Uid="Menu_EnableFeature" Click="CmdEnable_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE73E;"/>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Uid="Menu_DisableFeature" Click="CmdDisable_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE711;"/>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Uid="Menu_RestoreFeature" Click="CmdRestore_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE777;"/>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator/>
                                        <MenuFlyoutItem x:Uid="Menu_CopyText" Click="CmdCopy_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8C8;"/>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Uid="Menu_SelectAll" Click="CmdSelectAll_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8B3;"/>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </TextBlock.ContextFlyout>                            </TextBlock>
                            <TextBlock VerticalAlignment="Top" IsTextSelectionEnabled="True" TextWrapping="Wrap"
                               SelectionFlyout="{x:Null}"
                               local:SearchHighlight.SourceText="{x:Bind Description}"
                               local:SearchHighlight.Query="{x:Bind Query, Mode=OneWay}"
                               local:SearchHighlight.CaseSensitive="{x:Bind CaseSensitive, Mode=OneWay}"
                               local:SearchHighlight.IsCurrentField="{x:Bind DescIsCurrent, Mode=OneWay}"
                               local:SearchHighlight.CurrentMatchPos="{x:Bind CurrentMatchPos, Mode=OneWay}">
                                <TextBlock.ContextFlyout>
                                    <MenuFlyout Opening="FeatureRowMenuFlyout_Opening">
                                        <MenuFlyoutItem x:Uid="Menu_EnableFeature" Click="CmdEnable_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE73E;"/>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Uid="Menu_DisableFeature" Click="CmdDisable_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE711;"/>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Uid="Menu_RestoreFeature" Click="CmdRestore_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE777;"/>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator/>
                                        <MenuFlyoutItem x:Uid="Menu_CopyText" Click="CmdCopy_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8C8;"/>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Uid="Menu_SelectAll" Click="CmdSelectAll_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8B3;"/>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </TextBlock.ContextFlyout>                            </TextBlock>
                            <Border/>
                        </ct:DataRow>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>            <ListView.ItemContainerStyle>
                <Style BasedOn="{StaticResource ListViewItemRevealStyle}" TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <Border x:Name="LoadingOverlay" Grid.Row="0" Grid.RowSpan="2" Background="#66000000" Visibility="Collapsed" Canvas.ZIndex="100">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <ProgressRing IsActive="True" Width="60" Height="60"/>
                <TextBlock x:Name="LoadingText" Text="" HorizontalAlignment="Center" FontSize="14" Opacity="0.8"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
